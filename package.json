{
  "name": "x-bookmark-recall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "check": "find extension site -name \"*.js\" -exec node --check \"{}\" + && npm test",
